local function sendNotification(title, text)

    if destroyed then
        return
    end

    task.spawn(function()

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 280, 0, 65)
        frame.Position = UDim2.new(1, 20, 0.82, 0)
        frame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
        frame.BackgroundTransparency = 0.08
        frame.BorderSizePixel = 0
        frame.ZIndex = 100
        frame.Parent = NotificationHolder

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(0, 255, 170)
        stroke.Thickness = 1.5
        stroke.Parent = frame

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, -20, 0, 22)
        titleLabel.Position = UDim2.new(0, 10, 0, 6)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = title
        titleLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
        titleLabel.TextSize = 13
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.ZIndex = 101
        titleLabel.Parent = frame

        local descLabel = Instance.new("TextLabel")
        descLabel.Size = UDim2.new(1, -20, 0, 28)
        descLabel.Position = UDim2.new(0, 10, 0, 28)
        descLabel.BackgroundTransparency = 1
        descLabel.Text = text
        descLabel.TextColor3 = Color3.fromRGB(200, 200, 215)
        descLabel.TextSize = 11
        descLabel.Font = Enum.Font.Gotham
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.TextWrapped = true
        descLabel.ZIndex = 101
        descLabel.Parent = frame

        TweenService:Create(
            frame,
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            {
                Position = UDim2.new(1, -300, 0.82, 0)
            }
        ):Play()

        task.wait(2.5)

        if frame.Parent then

            local fadeOut = TweenService:Create(
                frame,
                TweenInfo.new(
                    0.35,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In
                ),
                {
                    Position = UDim2.new(1, 20, 0.82, 0)
                }
            )

            fadeOut:Play()
            fadeOut.Completed:Wait()

            if frame.Parent then
                frame:Destroy()
            end

        end

    end)

end

