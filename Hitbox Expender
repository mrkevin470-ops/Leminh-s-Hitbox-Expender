-- =========================================================
-- SET Q MULTIPLIER
-- =========================================================

local function setQMultiplier(value, notify)

    if destroyed then
        return
    end

    value = tonumber(value)

    if not value then
        value = qMultiplier
    end

    value = math.clamp(
        math.floor(value + 0.5),
        MIN_MULTIPLIER,
        MAX_MULTIPLIER
    )

    -- Chỉ thay đổi giá trị của Q
    qMultiplier = value

    QBox.Text = tostring(qMultiplier)
    SliderValue.Text = tostring(qMultiplier) .. "x"

    local percent =
        (qMultiplier - MIN_MULTIPLIER)
        / (MAX_MULTIPLIER - MIN_MULTIPLIER)

    SliderFill.Size =
        UDim2.new(percent, 0, 1, 0)

    SliderKnob.Position =
        UDim2.new(percent, 0, 0.5, 0)

    if notify then

        sendNotification(
            "Q Multiplier",
            "Q = " .. tostring(qMultiplier) .. "x"
        )
    end
end

-- =========================================================
-- SLIDER DRAG
-- =========================================================

local sliderDragging = false

local function updateSlider(input)

    if destroyed then
        return
    end

    local mouseX = input.Position.X

    local barStart =
        SliderBar.AbsolutePosition.X

    local barWidth =
        SliderBar.AbsoluteSize.X

    if barWidth <= 0 then
        return
    end

    local percent = math.clamp(
        (mouseX - barStart) / barWidth,
        0,
        1
    )

    local value = math.floor(
        MIN_MULTIPLIER
        + percent
            * (MAX_MULTIPLIER - MIN_MULTIPLIER)
        + 0.5
    )

    setQMultiplier(value, false)
end

connect(SliderKnob.InputBegan, function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true
    end
end)

connect(SliderBar.InputBegan, function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true
        updateSlider(input)
    end
end)

connect(UserInputService.InputChanged, function(input)

    if sliderDragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            updateSlider(input)
        end
    end
end)

connect(UserInputService.InputEnded, function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if sliderDragging then

            sliderDragging = false

            sendNotification(
                "Q Multiplier",
                "Q = "
                    .. tostring(qMultiplier)
                    .. "x"
            )
        end
    end
end)

