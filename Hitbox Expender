            currentMultiplier = value

            QBox.Text = tostring(qMultiplier)
            CurrentValueLabel.Text = tostring(qMultiplier) .. "x"

            -- Slider cũng chạy tới giá trị Q
            local percent = (qMultiplier - 1) / 49

            SliderFill.Size = UDim2.new(
                percent,
                0,
                1,
                0
            )

            SliderButton.Position = UDim2.new(
                percent,
                -11,
                0.5,
                -11
            )

            sendNotification(
                "Keybind",
                "Hitbox = " .. tostring(qMultiplier) .. "x [Q]"
            )

        end

    -- =====================================================
    -- E = 1X
    -- KHÔNG ĐỔI QBOX
    -- =====================================================

    elseif input.KeyCode == Enum.KeyCode.E then

        currentMultiplier = 1

        CurrentValueLabel.Text = "1x"

        -- Chỉ slider về 1x
        SliderFill.Size = UDim2.new(
            0,
            0,
            1,
            0
        )

        SliderButton.Position = UDim2.new(
            0,
            -11,
            0.5,
            -11
        )

        -- QUAN TRỌNG:
        -- QBox KHÔNG thay đổi
        -- qMultiplier vẫn giữ giá trị Q

        sendNotification(
            "Keybind",
            "Hitbox = 1x [E] | Q = "
                .. tostring(qMultiplier) .. "x"
        )

    end

end)

-- =========================================================
-- HITBOX ENGINE
-- =========================================================

RunService.RenderStepped:Connect(function()

    if destroyed then
        return
    end

    if not expanderEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer
            and player.Character then

            local character = player.Character

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then

                for _, part in ipairs(character:GetChildren()) do

                    if part:IsA("BasePart")
                        and (
                            part.Name == "Head"
                            or part.Name == "HumanoidRootPart"
                            or part.Name:find("Torso")
                            or part.Name:find("Arm")
                            or part.Name:find("Leg")
                        ) then

                        -- Lưu trạng thái ban đầu
                        if not originalSizes[part] then

                            originalSizes[part] =
                                part.Size

                            originalTransparency[part] =
                                part.Transparency

                            originalCanCollide[part] =
                                part.CanCollide

                            originalMassless[part] =
                                part.Massless

                        end

                        -- =================================================
                        -- CURRENT MULTIPLIER
                        -- =================================================

                        if currentMultiplier > 1 then

                            part.Size =
                                originalSizes[part]
                                * currentMultiplier

                            part.Transparency = 0.5
                            part.CanCollide = false
                            part.Massless = true

                        else

                            part.Size =
                                originalSizes[part]

                            part.Transparency =
                                originalTransparency[part]

                            part.CanCollide =
                                originalCanCollide[part]

                            part.Massless =
                                originalMassless[part]

                        end

                    end

                end

            end

        end

    end

end)

