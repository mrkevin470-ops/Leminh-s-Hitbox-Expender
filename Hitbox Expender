-- =========================================================
-- KEY BOX PARSER
-- =========================================================

local function getKeyCodeFromText(text)

    text = string.upper(string.gsub(text, "%s+", ""))

    if #text ~= 1 then
        return nil
    end

    local keyName = text

    local success, keyCode =
        pcall(function()
            return Enum.KeyCode[keyName]
        end)

    if success and keyCode then
        return keyCode
    end

    return nil

end

-- =========================================================
-- CHANGE Q KEY
-- =========================================================

QKeyBox.FocusLost:Connect(function()

    local newKey = getKeyCodeFromText(QKeyBox.Text)

    if newKey then

        qKey = newKey
        QKeyBox.Text = string.upper(QKeyBox.Text)

        QLabel.Text =
            QKeyBox.Text .. " →"

        sendNotification(
            "Keybind",
            "Q key changed to [" .. QKeyBox.Text .. "]"
        )

    else

        QKeyBox.Text =
            qKey.Name

        QLabel.Text =
            qKey.Name .. " →"

        sendNotification(
            "Keybind",
            "Invalid Q key."
        )

    end

end)

