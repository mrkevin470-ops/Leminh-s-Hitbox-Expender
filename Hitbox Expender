UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    -- =========================================
    -- CHANGE Q KEY
    -- =========================================

    if waitingForQKey then

        qKey = input.KeyCode
        QKeyBox.Text = qKey.Name
        waitingForQKey = false

        sendNotification(
            "Keybind",
            "Q = [" .. qKey.Name .. "]"
        )

        return

    end

    -- =========================================
    -- CHANGE E KEY
    -- =========================================

    if waitingForEKey then

        eKey = input.KeyCode
        EKeyBox.Text = eKey.Name
        waitingForEKey = false

        sendNotification(
            "Keybind",
            "E = [" .. eKey.Name .. "]"
        )

        return

    end

    -- =========================================
    -- Q
    -- =========================================

    if input.KeyCode == qKey then

        activeMultiplier = qMultiplier

        sendNotification(
            "Keybind",
            "["
            .. qKey.Name
            .. "] → "
            .. tostring(qMultiplier)
            .. "x"
        )

    -- =========================================
    -- E
    -- =========================================

    elseif input.KeyCode == eKey then

        activeMultiplier = eMultiplier

        sendNotification(
            "Keybind",
            "["
            .. eKey.Name
            .. "] → "
            .. tostring(eMultiplier)
            .. "x"
        )

    end

end)

-- =========================================================
-- HITBOX ENGINE
-- =========================================================

local function isHitboxPart(part)

    return part:IsA("BasePart")
        and (
            part.Name == "Head"
            or part.Name == "HumanoidRootPart"
            or part.Name:find("Torso")
            or part.Name:find("Arm")
            or part.Name:find("Leg")
        )

end

local function saveOriginal(part)

    if not originalSizes[part] then
        originalSizes[part] = part.Size
        originalTransparency[part] = part.Transparency
        originalCanCollide[part] = part.CanCollide
        originalMassless[part] = part.Massless
    end

end

local function restorePart(part)

    if originalSizes[part] then

        pcall(function()

            part.Size = originalSizes[part]

            if originalTransparency[part] ~= nil then
                part.Transparency = originalTransparency[part]
            end

            if originalCanCollide[part] ~= nil then
                part.CanCollide = originalCanCollide[part]
            end

            if originalMassless[part] ~= nil then
                part.Massless = originalMassless[part]
            end

        end)

    end

end

RunService.RenderStepped:Connect(function()

    if not expanderEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            local humanoid =
                player.Character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then

                for _, part in ipairs(player.Character:GetChildren()) do

                    if isHitboxPart(part) then

                        saveOriginal(part)

                        if activeMultiplier > 1 then

                            part.Size =
                                originalSizes[part]
                                * activeMultiplier

                            part.Transparency = 0.5
                            part.CanCollide = false
                            part.Massless = true

                        else

                            restorePart(part)

                        end

                    end

                end

            end

        end

    end

end)

-- =========================================================
-- DESTROY / CLEANUP
-- =========================================================

local destroyed = false

local function cleanup()

    if destroyed then
        return
    end

    destroyed = true

    expanderEnabled = false

    -- Restore tất cả part đã thay đổi
    for part, _ in pairs(originalSizes) do

        if part and part.Parent then
            restorePart(part)
        end

    end

    originalSizes = {}
    originalTransparency = {}
    originalCanCollide = {}
    originalMassless = {}

    sendNotification(
        "Hitbox",
        "GUI destroyed."
    )

    task.wait(0.15)

    if ScreenGui then
        ScreenGui:Destroy()
    end

end

DestroyButton.MouseButton1Click:Connect(cleanup)

