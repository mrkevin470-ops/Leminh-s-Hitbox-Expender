            "Keybind",
            "Invalid E key."
        )

    end

end)

-- =========================================================
-- KEYBINDS
-- =========================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if destroyed or gameProcessed then
        return
    end

    -- Không xử lý hotkey khi đang nhập vào TextBox
    if UserInputService:GetFocusedTextBox() then
        return
    end

    -- =====================================================
    -- Q = Q MULTIPLIER
    -- =====================================================

    if input.KeyCode == qKey then

        activeMultiplier = qMultiplier

        sendNotification(
            "Keybind",
            "Hitbox = " ..
            tostring(qMultiplier) ..
            "x [" ..
            qKey.Name ..
            "]"
        )

    -- =====================================================
    -- E = 1X
    -- =====================================================

    elseif input.KeyCode == eKey then

        activeMultiplier = 1

        sendNotification(
            "Keybind",
            "Hitbox = 1x [" ..
            eKey.Name ..
            "]"
        )

    end

end)

-- =========================================================
-- HITBOX ENGINE
-- =========================================================

RunService.RenderStepped:Connect(function()

    if destroyed then
        return
    end

    if not expanderEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            local character = player.Character

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then

                for _, part in ipairs(character:GetChildren()) do

                    if part:IsA("BasePart")
                        and (
                            part.Name == "Head"
                            or part.Name == "HumanoidRootPart"
                            or string.find(part.Name, "Torso")
                            or string.find(part.Name, "Arm")
                            or string.find(part.Name, "Leg")
                        ) then

                        if not originalSizes[part] then

                            originalSizes[part] =
                                part.Size

                        end

                        if activeMultiplier > 1 then

                            part.Size =
                                originalSizes[part]
                                * activeMultiplier

                            part.Transparency = 0.5
                            part.CanCollide = false
                            part.Massless = true

                        else

                            part.Size =
                                originalSizes[part]

                            if part.Name ==
                                "HumanoidRootPart" then

                                part.Transparency = 1

                            else

                                part.Transparency = 0

                            end

                            part.CanCollide =
                                part.Name ~= "HumanoidRootPart"

                            part.Massless = false

                        end

                    end

                end

            end

        end

    end

end)

