-- =========================================================
-- SLIDER DRAG
-- =========================================================

local sliderDragging = false

local function updateSlider(input)

    local relativeX =
        math.clamp(
            input.Position.X - SliderBack.AbsolutePosition.X,
            0,
            SliderBack.AbsoluteSize.X
        )

    local percent =
        relativeX / SliderBack.AbsoluteSize.X

    local value =
        math.floor(1 + percent * 49 + 0.5)

    qMultiplier = value
    QValueBox.Text = tostring(value)
    SliderValue.Text = tostring(value) .. "x"

    SliderFill.Size =
        UDim2.new(percent, 0, 1, 0)

    SliderKnob.Position =
        UDim2.new(percent, -9, 0.5, -9)

end

SliderKnob.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true
    end

end)

SliderBack.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true
        updateSlider(input)
    end

end)

UserInputService.InputChanged:Connect(function(input)

    if sliderDragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            updateSlider(input)

        end

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = false

    end

end)

-- =========================================================
-- KEYBOARD INPUT
-- =========================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    -- Change Q key
    if waitingForQKey then

        qKey = input.KeyCode
        QKeyBox.Text = input.KeyCode.Name
        waitingForQKey = false

        sendNotification(
            "Keybind",
            "Q key changed to [" .. input.KeyCode.Name .. "]"
        )

        return
    end

    -- Change E key
    if waitingForEKey then

        eKey = input.KeyCode
        EKeyBox.Text = input.KeyCode.Name
        waitingForEKey = false

        sendNotification(
            "Keybind",
            "E key changed to [" .. input.KeyCode.Name .. "]"
        )

        return
    end

    -- Q
    if input.KeyCode == qKey then

        sendNotification(
            "Keybind",
            "Hitbox = " .. tostring(qMultiplier) .. "x [" .. qKey.Name .. "]"
        )

    -- E
    elseif input.KeyCode == eKey then

        sendNotification(
            "Keybind",
            "Hitbox = " .. tostring(eMultiplier) .. "x [" .. eKey.Name .. "]"
        )

    end

end)

-- =========================================================
-- HITBOX ENGINE
-- =========================================================

RunService.RenderStepped:Connect(function()

    if not expanderEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            local humanoid =
                player.Character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then

                for _, part in ipairs(player.Character:GetChildren()) do

                    if part:IsA("BasePart")
                        and (
                            part.Name == "Head"
                            or part.Name == "HumanoidRootPart"
                            or part.Name:find("Torso")
                            or part.Name:find("Arm")
                            or part.Name:find("Leg")
                        ) then

                        if not originalSizes[part] then
                            originalSizes[part] = part.Size
                        end

                        -- Q multiplier is active by default.
                        -- E can change it to its own independent value.
                        local multiplier = qMultiplier

                        if multiplier > 1 then

                            part.Size =
                                originalSizes[part] * multiplier

                            part.Transparency = 0.5
                            part.CanCollide = false
                            part.Massless = true

                        else

                            part.Size = originalSizes[part]

                            if part.Name == "HumanoidRootPart" then
                                part.Transparency = 1
                            else
                                part.Transparency = 0
                            end

                            part.CanCollide =
                                part.Name ~= "HumanoidRootPart"

                            part.Massless = false

                        end

                    end

                end

            end

        end

    end

end)

