-- SLIDER UPDATE
-- =========================================================

local sliderDragging = false

local function setSliderValue(value)

    value = math.floor(math.clamp(value, 1, 50))

    currentMultiplier = value
    qMultiplier = value

    QBox.Text = tostring(value)
    CurrentValueLabel.Text = tostring(value) .. "x"

    local percent = (value - 1) / 49

    SliderFill.Size = UDim2.new(
        percent,
        0,
        1,
        0
    )

    SliderButton.Position = UDim2.new(
        percent,
        -11,
        0.5,
        -11
    )

end

local function updateSliderFromInput(input)

    local absoluteX = input.Position.X
    local sliderX = SliderBackground.AbsolutePosition.X
    local sliderWidth = SliderBackground.AbsoluteSize.X

    local percent = (absoluteX - sliderX) / sliderWidth
    percent = math.clamp(percent, 0, 1)

    local value = math.floor(1 + (percent * 49) + 0.5)

    setSliderValue(value)

end

SliderButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true

    end

end)

SliderButton.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = false

    end

end)

SliderBackground.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        sliderDragging = true
        updateSliderFromInput(input)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if sliderDragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement
